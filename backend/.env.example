# База данных
# Relative to backend/ when launching as documented.
DB_PATH=../data/arena.db

# JWT
SECRET_KEY=arena-dev-secret-change-me-please-32b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GigaChat (основной LLM)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_CA_BUNDLE_FILE=

# gpt2giga прокси
GPT2GIGA_MODE=PROD
GPT2GIGA_PORT=8090
GPT2GIGA_API_KEY=

# Ollama (резервный LLM)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Приложение
LLM_TIMEOUT=7
MAX_ACTIVE_SESSIONS=10

# Локальное распознавание речи (модель загружается при первом голосовом ходе)
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ru
